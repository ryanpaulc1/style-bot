{
  "name": "token-atelier",
  "version": "1.0.0",
  "description": "CLI tool for installing Token Atelier style guides into React + Tailwind projects",
  "author": "Token Atelier",
  "license": "MIT",
  "type": "module",
  "bin": {
    "token-atelier": "./bin/token-atelier.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
